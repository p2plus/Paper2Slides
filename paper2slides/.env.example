# Required for summary, planning, and RAG stages
RAG_LLM_API_KEY=""

# Optional if you are not using the default OpenAI endpoint
# Local LLM (Ollama: http://localhost:11434/v1, LM Studio: http://localhost:1234/v1,
# vLLM / llama.cpp server: http://localhost:8000/v1)
RAG_LLM_BASE_URL=""

# Core model choices
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
# max_tokens: default 16000; set to 8192 if using deepseek
RAG_LLM_MAX_TOKENS=""

# Image generation
IMAGE_GEN_PROVIDER=openrouter
IMAGE_GEN_API_KEY=""
IMAGE_GEN_BASE_URL=https://openrouter.ai/api/v1
IMAGE_GEN_MODEL=""
GOOGLE_GENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
IMAGE_GEN_RESPONSE_MIME_TYPE=text/plain

# Parser / RAG behavior
PARSER=mineru
PARSE_METHOD=auto
MAX_CONCURRENT_FILES=1
VERBOSE=false
# Open AI
RAG_LLM_API_KEY=""
RAG_LLM_BASE_URL=""
# max_tokens: default 16000; set to 8192 if using deepseek
RAG_LLM_MAX_TOKENS=""

# Image Generation
# provider: openrouter (default) or google
IMAGE_GEN_PROVIDER="openrouter"
IMAGE_GEN_API_KEY=""
IMAGE_GEN_BASE_URL=""
IMAGE_GEN_MODEL=""
IMAGE_GEN_RESPONSE_MIME_TYPE="image/png"
GOOGLE_GENAI_BASE_URL=""

# PDF Parsing (issue #29: alternative parsing options)
# parser: mineru (default, OCR-based) or docling (lighter, no GPU needed)
PARSER="mineru"
# parse_method: auto, ocr, or txt
PARSE_METHOD="auto"
# Hard deadline in seconds for the parser subprocess (issue #29 hang guard).
# 0 disables the deadline. Docs on slow machines may need a higher value.
PARSE_TIMEOUT_S="1800"
# On PDF parser failure/timeout, retry once with the other parser
PARSE_FALLBACK_ENABLED="true"
# Skip parsing entirely: provide pre-parsed markdown (.md/.txt) or
# MinerU content JSON as input instead of a PDF (CLI: --skip-parsing)
SKIP_PARSING=""

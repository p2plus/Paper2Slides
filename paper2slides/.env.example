# Paper2Slides environment configuration
# Copy this file to paper2slides/.env and fill in your values:
#   cp paper2slides/.env.example paper2slides/.env
# .env is loaded automatically when the app starts; variables left out
# fall back to the defaults documented below.

# ── LLM (required) ────────────────────────────────────────────────
# Any OpenAI-compatible endpoint: OpenAI, DeepSeek, or local servers
# (Ollama, LM Studio, vLLM, llama.cpp, SGLang).
RAG_LLM_API_KEY=""
# Optional. Empty = OpenAI official API. Examples:
#   DeepSeek:  https://api.deepseek.com/v1
#   Ollama:    http://localhost:11434/v1
#   LM Studio: http://localhost:1234/v1
RAG_LLM_BASE_URL=""
# Optional. Override the model used by the RAG query/plan/summary stages. Default:
#   gpt-4o-mini (plan stage uses gpt-4o unless set). For local LLMs you MUST set this,
#   e.g. qwen2.5:14b
#LLM_MODEL="gpt-4o-mini"
# Optional. max_tokens for slide content generation. Default: 16000. Set to 8192 if
# using deepseek.
#RAG_LLM_MAX_TOKENS="16000"

# Fast mode (--fast) sends document images to the LLM: use a vision-capable model
# there (e.g. llama3.2-vision, qwen2.5-vl). Image generation (slides/poster
# rendering) always needs a real image-capable model via IMAGE_GEN_* below.

# ── Embeddings (required for RAG) ─────────────────────────────────
# Optional. Default: text-embedding-3-large. For Ollama e.g. nomic-embed-text
#EMBEDDING_MODEL="text-embedding-3-large"
# Optional. Must match the actual output dimension of EMBEDDING_MODEL. Default: 3072
# (text-embedding-3-large). For Ollama nomic-embed-text use 768. A mismatch causes
# vector count validation errors.
#EMBEDDING_DIM="3072"

# ── Image Generation (required for slide/poster rendering) ───────
# provider: openrouter (default) or google
IMAGE_GEN_PROVIDER="openrouter"
IMAGE_GEN_API_KEY=""
# Optional. Default: https://openrouter.ai/api/v1
IMAGE_GEN_BASE_URL=""
# Optional. Model depends on the provider.
IMAGE_GEN_MODEL=""
# Optional. Response format for generated images. Default: image/png
IMAGE_GEN_RESPONSE_MIME_TYPE="image/png"
# Optional. Override the Google GenAI endpoint. Default:
#   https://generativelanguage.googleapis.com/v1beta
GOOGLE_GENAI_BASE_URL=""

# ── Document Parsing (optional) ───────────────────────────────────
# Optional. Parser backend. Default: mineru
#PARSER="mineru"
# Optional. Parse method: auto, txt, ocr. Default: auto
#PARSE_METHOD="auto"
# Optional. Mark content format: minerU (default) or markdown
#CONTENT_FORMAT="minerU"

# ── RAG Storage Paths (optional) ──────────────────────────────────
# Optional. Where the RAG index lives and parsed papers are written.
# Relative paths resolve against the paper2slides/ directory. Defaults:
#   paper2slides/rag/storage and paper2slides/rag/output
#RAG_STORAGE_DIR=""
#RAG_OUTPUT_DIR=""

# ── Batch Processing (optional) ───────────────────────────────────
# Optional. Files processed concurrently by RAG ingest. Default: 1
#MAX_CONCURRENT_FILES="1"
# Optional. Walk input folders recursively. Default: true
#RECURSIVE_FOLDER_PROCESSING="true"
# Optional. Comma-separated list of file extensions accepted for RAG ingest. Default:
#   .pdf,.jpg,.jpeg,.png,.bmp,.tiff,.tif,.gif,.webp,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt,.md
#SUPPORTED_FILE_EXTENSIONS=".pdf,.txt,.md"

# ── Context Assembly (optional) ───────────────────────────────────
# Optional. Sliding window of neighbour pages joined to each retrieved page. Default: 1
#CONTEXT_WINDOW="1"
# Optional. Context mode: page (default) or chunk
#CONTEXT_MODE="page"
# Optional. Token budget for assembled context per RAG query. Default: 2000
#MAX_CONTEXT_TOKENS="2000"
# Optional. Include page/canvas headers in context. Default: true
#INCLUDE_HEADERS="true"
# Optional. Include figure/table captions in context. Default: true
#INCLUDE_CAPTIONS="true"
# Optional. Comma-separated content types kept in context. Default: text
# (e.g. "text,image,table,equation")
#CONTEXT_FILTER_CONTENT_TYPES="text"

# ── Multimodal Extraction (optional) ──────────────────────────────
# Optional. Extract/describe images during parsing. Default: true
#ENABLE_IMAGE_PROCESSING="true"
# Optional. Extract tables at parsing time. Default: true
#ENABLE_TABLE_PROCESSING="true"
# Optional. Extract equations at parsing time. Default: true
#ENABLE_EQUATION_PROCESSING="true"
# Optional. Print content-block statistics after parsing. Default: true
#DISPLAY_CONTENT_STATS="true"

# ── Logging (optional) ────────────────────────────────────────────
# Optional. Verbose logging output. Default: false
#VERBOSE="false"